{
  "name": "context",
  "version": "0.1.0",
  "description": "deterministic discovery compiler for coding agents",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "context": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "install:local": "bash install.sh --local",
    "spike": "bun run spike/bench.ts",
    "eval": "bun run scripts/eval.ts",
    "bench": "bun run scripts/bench.ts",
    "grammars": "bun run scripts/embed-grammars.ts",
    "build": "bun run scripts/embed-grammars.ts && mkdir -p dist && bun run scripts/package.ts && bun build --compile src/cli.ts --outfile dist/context && bash scripts/sign.sh dist/context",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.1.9",
    "@huggingface/transformers": "^4.2.0",
    "ignore": "^7.0.0",
    "tree-sitter-bash": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
