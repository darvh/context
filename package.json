{
  "name": "context",
  "version": "0.1.0",
  "description": "deterministic discovery compiler for coding agents",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "context": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "install:local": "bash install.sh --local",
    "eval": "bun run eval/eval.ts",
    "bench": "bun run eval/bench.ts",
    "fixture": "bun run eval/gen-fixture.ts",
    "grammars": "bun run scripts/build/embed-grammars.ts",
    "dup": "npx jscpd src scripts eval",
    "unused": "npx knip",
    "build": "bun run scripts/build/vendor-onnx.ts && bun run scripts/build/embed-grammars.ts && mkdir -p dist && bun run scripts/build/package.ts && bun build --compile --asset ./grammars --asset ./skill src/cli.ts --outfile dist/context && bash scripts/build/sign.sh dist/context",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "bun run scripts/build/vendor-onnx.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@c4312/scip": "^0.1.0",
    "@firecrawl/anydoc": "^0.1.9",
    "@huggingface/transformers": "^4.2.0",
    "ignore": "^7.0.0",
    "tree-sitter-bash": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "typescript": "^7.0.2"
  }
}
