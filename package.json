{
  "name": "context",
  "version": "0.1.0",
  "description": "deterministic discovery compiler for coding agents",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "context": "./bin/context.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "spike": "bun run spike/bench.ts",
    "grammars": "bun run scripts/embed-grammars.ts",
    "build": "bun run scripts/embed-grammars.ts && bun build --compile src/cli.ts --outfile context-bin",
    "test": "bun test"
  },
  "dependencies": {
    "ignore": "^7.0.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
